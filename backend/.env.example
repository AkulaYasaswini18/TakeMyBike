# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/bikeshare

# HTTP server configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Use a long random value in every deployed environment.
JWT_SECRET=replace_with_a_long_random_secret

# Optional seeded administrator overrides
ADMIN_EMAIL=admin@bikeshare.com
ADMIN_PASSWORD=replace_with_a_local_admin_password
ADMIN_NAME=Platform Administrator
ADMIN_PHONE=9999999999

# Optional SMTP settings used by registration and password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
